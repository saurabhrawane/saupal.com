---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.set(slugifyTag(t), t)));
  return [...tags].map(([slug, label]) => ({
    params: { tag: slug },
    props: { label, posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)) },
  }));
}

const { label, posts } = Astro.props;
---

<Base title={`#${label}`} description={`Posts tagged ${label}.`}>
  <header class="page-header">
    <p class="eyebrow"><a href="/blog">← All writing</a></p>
    <h1>#{label}</h1>
    <p class="lede">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
  </header>
  <PostList posts={posts} />
</Base>
