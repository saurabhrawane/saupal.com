---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE, SOCIALS } from '../consts';
import { getPosts } from '../lib/content';

const posts = (await getPosts()).slice(0, 5);
---

<Base>
  <section class="hero">
    <p class="eyebrow">Hi, I'm {SITE.author} 👋</p>
    <h1>{SITE.tagline}</h1>
    <p class="lede">
      This is my corner of the internet: long-form notes on engineering and ideas, plus
      small proofs-of-concept with the code attached so you can run them yourself.
    </p>
    <p class="actions">
      <a class="btn" href="/blog">Read the writing</a>
      
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Latest writing</h2>
      <a href="/blog">All posts →</a>
    </div>
    <PostList posts={posts} />
  </section>
</Base>
