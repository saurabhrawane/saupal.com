---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../lib/content';

const posts = await getPosts();
const tagCounts = new Map<string, number>();
posts.flatMap((p) => p.data.tags).forEach((t) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1));
const tags = [...tagCounts].sort((a, b) => b[1] - a[1]);
---

<Base title="Writing" description="Essays, engineering notes, and things I've been thinking about.">
  <header class="page-header">
    <h1>Writing</h1>
    <p class="lede">Essays, engineering notes, and things I've been thinking about. <a href="/rss.xml">Subscribe via RSS</a>.</p>
    {tags.length > 0 && (
      <ul class="chips">
        {tags.map(([t, n]) => <li><a href={`/tags/${slugifyTag(t)}/`}>#{t} <span class="muted">{n}</span></a></li>)}
      </ul>
    )}
  </header>
  <PostList posts={posts} />
</Base>
