---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <section class="hero">
    <p class="eyebrow">404</p>
    <h1>That page doesn't exist (anymore).</h1>
    <p class="lede">The old site had different URLs — try the writing or projects below.</p>
    <p class="actions">
      <a class="btn" href="/">Home</a>
      <a class="btn btn-ghost" href="/blog">Writing</a>
      <a class="btn btn-ghost" href="/projects">Projects</a>
    </p>
  </section>
</Base>
