---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Projects" description="Proofs-of-concept and side projects, with code.">
  <header class="page-header">
    <h1>Projects &amp; POCs</h1>
    <p class="lede">Small experiments and side projects. Each one has a write-up and a link to the code.</p>
  </header>
  <div class="grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>
